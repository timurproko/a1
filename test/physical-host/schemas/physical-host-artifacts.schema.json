{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://addone.dev/schemas/physical-host-artifacts-v1.json",
  "title": "AddOne physical-host artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarioId", "evidenceRoot", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scenarioId": { "$ref": "#/$defs/id" },
    "evidenceRoot": { "$ref": "#/$defs/relativePath" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256", "bytes", "mediaType", "capturedAt", "producer", "independence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "enum": [
            "screenshot",
            "video",
            "child-observation",
            "host-state",
            "process-inventory",
            "native-trace",
            "stdout",
            "stderr",
            "timing-log",
            "action-log",
            "diagnostic"
          ]
        },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string", "minLength": 3, "maxLength": 120 },
        "capturedAt": { "type": "string", "minLength": 1 },
        "runId": { "$ref": "#/$defs/id" },
        "actionId": { "$ref": "#/$defs/id" },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "version"],
          "properties": {
            "kind": { "enum": ["os-ui-driver", "child-recorder", "host-inspector", "process-inspector", "clock", "manual"] },
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "independence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "productTerminalModelUsed"],
          "properties": {
            "source": { "enum": ["physical-host", "operating-system", "child-process", "monotonic-clock", "human-observer"] },
            "productTerminalModelUsed": { "const": false }
          }
        }
      }
    }
  }
}
