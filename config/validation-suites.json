{
  "schema": "a1-validation-suites-v1",
  "tiers": {
    "planning": {
      "kind": "commands",
      "commands": [
        {
          "id": "openspec-strict",
          "executable": "npx",
          "arguments": [
            "--yes",
            "@fission-ai/openspec@1.8.0",
            "validate",
            "--all",
            "--strict",
            "--no-interactive"
          ]
        }
      ]
    },
    "pr-core": {
      "kind": "composition",
      "includes": [
        "typecheck",
        "architecture",
        "pr-core-tests"
      ]
    },
    "fast": {
      "kind": "composition",
      "includes": [
        "fast-remainder",
        "fast-resource-sensitive"
      ]
    },
    "full-release": {
      "kind": "composition",
      "includes": [
        "typecheck",
        "architecture",
        "fast",
        "documentation-full",
        "naming-full",
        "rendering-stability",
        "dist-integration",
        "launch-integration",
        "pi-engine-conformance",
        "release-update",
        "update-performance",
        "package-smoke",
        "package-install",
        "image-compatibility",
        "history-compatibility",
        "unix-containment",
        "dependency-policy",
        "update-predecessor"
      ]
    }
  },
  "scopes": {
    "pr-selected-tests": {
      "kind": "dynamic-vitest",
      "requiresBuild": true
    },
    "pr-selected-resource": {
      "kind": "dynamic-vitest-resource-sensitive",
      "requiresBuild": true
    },
    "pr-core-tests": {
      "kind": "vitest-files",
      "tests": [
        "test/cli/capabilities.test.ts",
        "test/cli/dispatch.test.ts",
        "test/features/launch/runtime-selection.test.ts",
        "test/features/launch/terminal-colour-fidelity.test.ts",
        "test/foundation/launch-context/context.test.ts",
        "test/repository-governance/validation-suite-policy.test.ts"
      ]
    },
    "fast-remainder": {
      "kind": "vitest-remainder",
      "includeRoot": "test",
      "exclude": [
        "test/repository-governance/release-command.test.ts",
        "test/cli/update-cli.test.ts",
        "test/features/launch/development-launch.test.ts",
        "test/features/launch/exact-pi-entry.integration.test.ts",
        "test/features/launch/profile-isolation.integration.test.ts",
        "test/integrations/pi/engine/conformance.test.ts",
        "test/integrations/pi/engine/runtime-integration.test.ts",
        "test/integrations/pi/engine/session-integration.test.ts",
        "test/integrations/pi/session-ui/image-worker-package.test.ts",
        "test/features/prompt-history/worker-package.test.ts",
        "test/integrations/pi/tui-runtime/rendering-budgets.test.ts",
        "test/integrations/pi/tui-runtime/rendering-smoke.test.ts",
        "test/integrations/pi/tui-runtime/content-producer.test.ts",
        "test/integrations/pi/tui-runtime/rendering-producer.test.ts",
        "test/integrations/pi/tui-runtime/input-responsiveness-budgets.test.ts",
        "test/integrations/pi/tui-runtime/input-responsiveness-smoke.test.ts",
        "test/integrations/pi/tui-runtime/input-producer.test.ts",
        "test/foundation/release/package-surface.test.ts",
        "test/foundation/release/session-resume.integration.test.ts",
        "test/foundation/release/package-install.integration.test.ts",
        "test/foundation/release/package-startup.integration.test.ts",
        "test/foundation/release/update-performance.integration.test.ts",
        "test/foundation/release/update-transition.integration.test.ts",
        "test/foundation/release/update-predecessor.integration.test.ts"
      ]
    },
    "fast-resource-sensitive": {
      "kind": "vitest-resource-sensitive",
      "requiresBuild": true,
      "tests": [
        "test/repository-governance/validation-impact.test.ts",
        "test/repository-governance/naming-selection.test.ts",
        "test/foundation/launch-context/cutover.test.ts",
        "test/repository-governance/code-documentation.test.ts",
        "test/repository-governance/local-cleanup.test.ts",
        "test/foundation/storage/storage.test.ts",
        "test/foundation/release/cohort-state.test.ts",
        "test/foundation/release/release-gc.test.ts",
        "test/foundation/release/update-live-cohort.test.ts",
        "test/features/prompt-history/store.test.ts",
        "test/integrations/pi/session-ui/command-message-parity.test.ts",
        "test/integrations/pi/session-ui/command-outcome-parity.test.ts",
        "test/integrations/pi/session-ui/session-shell.test.ts",
        "test/integrations/pi/session-ui/session-shell-paste.test.ts",
        "test/integrations/pi/session-ui/paste-executor.test.ts",
        "test/integrations/pi/session-ui/clipboard-executor-lifecycle.test.ts",
        "test/integrations/pi/session-ui/clipboard-packaged.test.ts",
        "test/integrations/pi/components/editor-text-paste.test.ts",
        "test/integrations/pi/session-ui/prompt-history-controller.test.ts",
        "test/foundation/release/update-activation.test.ts"
      ]
    },
    "typecheck": {
      "kind": "commands",
      "commands": [
        {
          "id": "typecheck",
          "executable": "npm",
          "arguments": [
            "run",
            "typecheck"
          ]
        }
      ]
    },
    "architecture": {
      "kind": "commands",
      "commands": [
        {
          "id": "architecture",
          "executable": "npm",
          "arguments": [
            "run",
            "check:architecture"
          ]
        }
      ]
    },
    "naming-full": {
      "kind": "commands",
      "commands": [
        {
          "id": "internal-naming-full",
          "executable": "npm",
          "arguments": [
            "run",
            "check:names"
          ]
        }
      ]
    },
    "documentation-changed": {
      "kind": "commands",
      "commands": [
        {
          "id": "code-documentation-changed",
          "executable": "node",
          "arguments": [
            "scripts/release/run-changed-documentation.mjs"
          ]
        }
      ]
    },
    "documentation-full": {
      "kind": "commands",
      "commands": [
        {
          "id": "code-documentation-full",
          "executable": "npm",
          "arguments": [
            "run",
            "check:code-documentation"
          ]
        }
      ]
    },
    "rendering-smoke": {
      "kind": "vitest-isolated",
      "evidence": {
        "workloadCaptures": 6,
        "deliberateRepeatCaptures": 0,
        "matrixProducerLaunches": 19,
        "protocolProducerLaunches": 0,
        "totalProducerLaunches": 19
      },
      "tests": [
        "test/integrations/pi/tui-runtime/rendering-smoke.test.ts",
        "test/integrations/pi/tui-runtime/input-responsiveness-smoke.test.ts"
      ]
    },
    "rendering-stability": {
      "kind": "vitest-isolated",
      "evidence": {
        "workloadCaptures": 16,
        "deliberateRepeatCaptures": 0,
        "matrixProducerLaunches": 55,
        "protocolProducerLaunches": 10,
        "totalProducerLaunches": 65
      },
      "tests": [
        "test/integrations/pi/tui-runtime/rendering-budgets.test.ts",
        "test/integrations/pi/tui-runtime/content-producer.test.ts",
        "test/integrations/pi/tui-runtime/rendering-producer.test.ts",
        "test/integrations/pi/tui-runtime/input-responsiveness-budgets.test.ts",
        "test/integrations/pi/tui-runtime/input-producer.test.ts"
      ]
    },
    "dist-integration": {
      "kind": "vitest-files",
      "requiresBuild": true,
      "tests": [
        "test/cli/update-cli.test.ts",
        "test/features/launch/development-launch.test.ts",
        "test/integrations/pi/session-ui/image-worker-package.test.ts",
        "test/features/prompt-history/worker-package.test.ts"
      ]
    },
    "launch-integration": {
      "kind": "vitest-files",
      "requiresBuild": true,
      "tests": [
        "test/features/launch/exact-pi-entry.integration.test.ts",
        "test/features/launch/profile-isolation.integration.test.ts"
      ]
    },
    "pi-engine-conformance": {
      "kind": "mixed",
      "requiresBuild": true,
      "tests": [
        "test/integrations/pi/engine/conformance.test.ts",
        "test/integrations/pi/engine/runtime-integration.test.ts",
        "test/integrations/pi/engine/session-integration.test.ts"
      ],
      "commands": [
        {
          "id": "candidate-engine-conformance-report",
          "executable": "node",
          "arguments": [
            "scripts/pi/run-pi-engine-conformance.mjs"
          ]
        }
      ]
    },
    "release-update": {
      "kind": "vitest-files",
      "tests": [
        "test/foundation/release/update-transition.integration.test.ts",
        "test/repository-governance/release-command.test.ts"
      ]
    },
    "update-performance": {
      "kind": "vitest-files",
      "tests": [
        "test/foundation/release/update-performance.integration.test.ts"
      ]
    },
    "package-smoke": {
      "kind": "vitest-files",
      "requiresBuild": true,
      "consumesPackage": true,
      "tests": [
        "test/foundation/release/package-surface.test.ts",
        "test/foundation/release/session-resume.integration.test.ts"
      ]
    },
    "package-install": {
      "kind": "composition",
      "includes": [
        "package-contracts",
        "package-startup"
      ]
    },
    "package-contracts": {
      "kind": "vitest-package-contracts",
      "requiresBuild": true,
      "consumesPackage": true,
      "tests": [
        "test/foundation/release/package-install.integration.test.ts"
      ]
    },
    "package-startup": {
      "kind": "vitest-package-startup",
      "requiresBuild": true,
      "consumesPackage": true,
      "tests": [
        "test/foundation/release/package-startup.integration.test.ts"
      ]
    },
    "dependency-policy": {
      "kind": "commands",
      "commands": [
        {
          "id": "deprecated-dependencies",
          "executable": "npm",
          "arguments": [
            "run",
            "check:deprecated"
          ]
        }
      ]
    },
    "update-predecessor": {
      "kind": "vitest-files",
      "requiresBuild": true,
      "consumesPackage": true,
      "tests": [
        "test/foundation/release/update-predecessor.integration.test.ts"
      ]
    },
    "image-compatibility": {
      "kind": "vitest-files",
      "requiresBuild": true,
      "tests": [
        "test/integrations/pi/session-ui/image-preparation.test.ts",
        "test/integrations/pi/session-ui/image-worker-package.test.ts"
      ]
    },
    "history-compatibility": {
      "kind": "vitest-files",
      "requiresBuild": true,
      "tests": [
        "test/features/prompt-history/concurrency.integration.test.ts",
        "test/features/prompt-history/image-sidecar.test.ts",
        "test/features/prompt-history/service.test.ts",
        "test/features/prompt-history/store.test.ts",
        "test/features/prompt-history/worker-package.test.ts"
      ]
    },
    "unix-containment": {
      "kind": "vitest-files",
      "requiresBuild": true,
      "tests": [
        "test/foundation/process-containment/artifact.test.ts",
        "test/foundation/process-containment/contracts.test.ts",
        "test/foundation/process-containment/darwin-process-inspector.test.ts",
        "test/foundation/process-containment/source-boundary.test.ts",
        "test/foundation/process-containment/unix-process-group.integration.test.ts",
        "test/foundation/process-containment/windows-job.integration.test.ts",
        "test/foundation/process-containment/windows-process-inspector.test.ts",
        "test/foundation/launch-context/context.test.ts",
        "test/foundation/launch-context/cutover.test.ts",
        "test/foundation/release/update-transition.integration.test.ts",
        "test/foundation/release/dependency-certification.test.ts",
        "test/foundation/release/dependency-layer.test.ts",
        "test/foundation/release/restart-certification.test.ts",
        "test/foundation/release/release-gc.test.ts"
      ]
    }
  },
  "fullReleaseSupersedes": {
    "fast-remainder": [
      "pr-core-tests",
      "pr-selected-tests"
    ],
    "fast-resource-sensitive": [
      "pr-selected-resource"
    ],
    "documentation-full": [
      "documentation-changed"
    ],
    "rendering-stability": [
      "rendering-smoke"
    ]
  },
  "releaseContracts": {
    "architecture": "architecture",
    "compatibility-authority": "fast",
    "candidate-engine-conformance": "pi-engine-conformance",
    "exact-vanilla-oracle": "launch-integration",
    "packaged-public-entry": "package-smoke",
    "owned-ui-regression": "fast",
    "extension-behavior": "fast",
    "architecture-independent-n-minus-one-update-transition": "release-update",
    "post-update-startup-performance": "package-startup",
    "immutable-dependency-layer-compatibility": "package-contracts",
    "published-predecessor-update": "update-predecessor"
  }
}
