{
  "schema": "a1-validation-suites-v1",
  "tiers": {
    "planning": {
      "kind": "commands",
      "commands": [
        { "id": "openspec-strict", "executable": "npx", "arguments": ["--yes", "@fission-ai/openspec@1.8.0", "validate", "--all", "--strict", "--no-interactive"] }
      ]
    },
    "fast": {
      "kind": "vitest-remainder",
      "includeRoot": "test",
      "resourceSensitiveTests": [
        "test/repository-governance/validation-impact.test.ts",
        "test/repository-governance/code-documentation.test.ts",
        "test/foundation/storage/storage.test.ts",
        "test/foundation/release/cohort-state.test.ts",
        "test/foundation/release/update-live-cohort.test.ts"
      ],
      "exclude": [
        "test/cli/update-cli.test.ts",
        "test/features/launch/development-launch.test.ts",
        "test/features/launch/exact-pi-entry.integration.test.ts",
        "test/features/launch/profile-isolation.integration.test.ts",
        "test/integrations/pi/engine/conformance.test.ts",
        "test/integrations/pi/engine/runtime-integration.test.ts",
        "test/integrations/pi/engine/session-integration.test.ts",
        "test/integrations/pi/tui-runtime/rendering-budgets.test.ts",
        "test/integrations/pi/tui-runtime/rendering-smoke.test.ts",
        "test/integrations/pi/tui-runtime/rendering-producer.test.ts",
        "test/integrations/pi/tui-runtime/input-responsiveness-budgets.test.ts",
        "test/integrations/pi/tui-runtime/input-responsiveness-smoke.test.ts",
        "test/integrations/pi/tui-runtime/input-producer.test.ts",
        "test/foundation/release/package-surface.test.ts",
        "test/foundation/release/package-install.integration.test.ts",
        "test/foundation/release/update-performance.integration.test.ts",
        "test/foundation/release/update-transition.integration.test.ts",
        "test/foundation/structured-agent-runtime/runtime.integration.test.ts"
      ]
    },
    "full-release": {
      "kind": "composition",
      "includes": [
        "typecheck",
        "architecture",
        "fast",
        "documentation-full",
        "rendering-stability",
        "dist-integration",
        "launch-integration",
        "pi-engine-conformance",
        "release-update",
        "update-performance",
        "structured-runtime-integration",
        "package-smoke",
        "package-install",
        "dependency-policy"
      ]
    }
  },
  "scopes": {
    "typecheck": {
      "kind": "commands",
      "commands": [
        { "id": "typecheck", "executable": "npm", "arguments": ["run", "typecheck"] }
      ]
    },
    "architecture": {
      "kind": "commands",
      "commands": [
        { "id": "architecture", "executable": "npm", "arguments": ["run", "check:architecture"] }
      ]
    },
    "documentation-changed": {
      "kind": "commands",
      "commands": [
        { "id": "code-documentation-changed", "executable": "node", "arguments": ["scripts/release/run-changed-documentation.mjs"] }
      ]
    },
    "documentation-full": {
      "kind": "commands",
      "commands": [
        { "id": "code-documentation-full", "executable": "npm", "arguments": ["run", "check:code-documentation"] }
      ]
    },
    "rendering-smoke": {
      "kind": "vitest-isolated",
      "evidence": { "workloadCaptures": 4, "deliberateRepeatCaptures": 0, "matrixProducerLaunches": 15, "protocolProducerLaunches": 0, "totalProducerLaunches": 15 },
      "tests": [
        "test/integrations/pi/tui-runtime/rendering-smoke.test.ts",
        "test/integrations/pi/tui-runtime/input-responsiveness-smoke.test.ts"
      ]
    },
    "rendering-stability": {
      "kind": "vitest-isolated",
      "evidence": { "workloadCaptures": 14, "deliberateRepeatCaptures": 2, "matrixProducerLaunches": 60, "protocolProducerLaunches": 10, "totalProducerLaunches": 70 },
      "tests": [
        "test/integrations/pi/tui-runtime/rendering-budgets.test.ts",
        "test/integrations/pi/tui-runtime/rendering-producer.test.ts",
        "test/integrations/pi/tui-runtime/input-responsiveness-budgets.test.ts",
        "test/integrations/pi/tui-runtime/input-producer.test.ts"
      ]
    },
    "dist-integration": {
      "kind": "vitest-files",
      "requiresBuild": true,
      "tests": [
        "test/cli/update-cli.test.ts",
        "test/features/launch/development-launch.test.ts"
      ]
    },
    "launch-integration": {
      "kind": "vitest-files",
      "requiresBuild": true,
      "tests": [
        "test/features/launch/exact-pi-entry.integration.test.ts",
        "test/features/launch/profile-isolation.integration.test.ts"
      ]
    },
    "pi-engine-conformance": {
      "kind": "mixed",
      "requiresBuild": true,
      "tests": [
        "test/integrations/pi/engine/conformance.test.ts",
        "test/integrations/pi/engine/runtime-integration.test.ts",
        "test/integrations/pi/engine/session-integration.test.ts"
      ],
      "commands": [
        { "id": "candidate-engine-conformance-report", "executable": "node", "arguments": ["scripts/pi/run-pi-engine-conformance.mjs"] }
      ]
    },
    "release-update": {
      "kind": "vitest-files",
      "tests": [
        "test/foundation/release/update-transition.integration.test.ts"
      ]
    },
    "update-performance": {
      "kind": "vitest-files",
      "tests": [
        "test/foundation/release/update-performance.integration.test.ts"
      ]
    },
    "structured-runtime-integration": {
      "kind": "vitest-files",
      "tests": [
        "test/foundation/structured-agent-runtime/runtime.integration.test.ts"
      ]
    },
    "package-smoke": {
      "kind": "vitest-files",
      "requiresBuild": true,
      "consumesPackage": true,
      "tests": [
        "test/foundation/release/package-surface.test.ts"
      ]
    },
    "package-install": {
      "kind": "vitest-files",
      "requiresBuild": true,
      "consumesPackage": true,
      "tests": [
        "test/foundation/release/package-install.integration.test.ts"
      ]
    },
    "dependency-policy": {
      "kind": "commands",
      "commands": [
        { "id": "deprecated-dependencies", "executable": "npm", "arguments": ["run", "check:deprecated"] }
      ]
    }
  },
  "fullReleaseSupersedes": {
    "documentation-full": ["documentation-changed"],
    "rendering-stability": ["rendering-smoke"]
  },
  "releaseContracts": {
    "architecture": "architecture",
    "compatibility-authority": "fast",
    "candidate-engine-conformance": "pi-engine-conformance",
    "exact-vanilla-oracle": "launch-integration",
    "packaged-public-entry": "package-smoke",
    "owned-ui-regression": "fast",
    "extension-behavior": "fast",
    "architecture-independent-n-minus-one-update-transition": "release-update"
  }
}
