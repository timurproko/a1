{
  "schema": "a1-github-repository-governance-v1",
  "repository": "timurproko/a1",
  "repositorySettings": {
    "visibility": "public",
    "default_branch": "develop",
    "allow_auto_merge": true,
    "delete_branch_on_merge": true,
    "allow_merge_commit": true,
    "allow_squash_merge": true,
    "allow_rebase_merge": true,
    "allow_update_branch": false,
    "use_squash_pr_title_as_default": false,
    "squash_merge_commit_title": "COMMIT_OR_PR_TITLE",
    "squash_merge_commit_message": "COMMIT_MESSAGES",
    "merge_commit_title": "MERGE_MESSAGE",
    "merge_commit_message": "PR_TITLE",
    "web_commit_signoff_required": false
  },
  "actions": {
    "enabled": true,
    "allowed_actions": "all",
    "sha_pinning_required": false,
    "selected_actions": null,
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "securityCapabilities": {
    "secret_scanning": "enabled",
    "secret_scanning_push_protection": "enabled",
    "secret_scanning_non_provider_patterns": "disabled",
    "secret_scanning_validity_checks": "disabled",
    "dependabot_alerts": "disabled",
    "dependabot_security_updates": "disabled"
  },
  "environments": [
    {
      "name": "npm-publish",
      "can_admins_bypass": true,
      "protection_rules": [],
      "deployment_branch_policy": null
    }
  ],
  "protectedRefs": [
    "refs/heads/develop",
    "refs/heads/master",
    "refs/tags/v*"
  ],
  "rulesets": [
    {
      "name": "a1-protect-develop",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "include": ["refs/heads/develop"],
          "exclude": []
        }
      },
      "rules": [
        { "type": "deletion" },
        { "type": "non_fast_forward" },
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 0,
            "dismiss_stale_reviews_on_push": true,
            "required_reviewers": [],
            "require_code_owner_review": false,
            "require_last_push_approval": false,
            "required_review_thread_resolution": true,
            "require_extra_approval_for_unattributed_changes": true,
            "allowed_merge_methods": ["merge", "squash"]
          }
        },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": false,
            "do_not_enforce_on_create": false,
            "required_status_checks": [
              { "context": "Development validation required" }
            ]
          }
        }
      ]
    },
    {
      "name": "a1-protect-master",
      "target": "branch",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "include": ["refs/heads/master"],
          "exclude": []
        }
      },
      "rules": [
        { "type": "deletion" },
        { "type": "non_fast_forward" }
      ]
    },
    {
      "name": "a1-protect-release-tags",
      "target": "tag",
      "enforcement": "active",
      "bypass_actors": [],
      "conditions": {
        "ref_name": {
          "include": ["refs/tags/v*"],
          "exclude": []
        }
      },
      "rules": [
        { "type": "deletion" },
        { "type": "non_fast_forward" }
      ]
    }
  ],
  "workflows": [
    {
      "name": "Development validation",
      "path": ".github/workflows/ci.yml",
      "state": "active",
      "triggers": ["pull_request", "workflow_dispatch"],
      "permissions": ["contents: read"],
      "trustedSource": "pull-request-head-read-only",
      "authority": ["Development validation required"],
      "concurrency": "development-validation-",
      "environments": [],
      "artifactRetentionDays": []
    },
    {
      "name": "Documentation auto-merge",
      "path": ".github/workflows/documentation-auto-merge.yml",
      "state": "active",
      "triggers": ["pull_request_target", "workflow_run"],
      "permissions": ["contents: write", "pull-requests: write"],
      "trustedSource": "default-branch",
      "authority": ["documentation-auto-merge"],
      "concurrency": "documentation-auto-merge-",
      "environments": [],
      "artifactRetentionDays": []
    },
    {
      "name": "Full regression",
      "path": ".github/workflows/full-regression.yml",
      "state": "active",
      "triggers": ["workflow_dispatch"],
      "permissions": ["contents: read"],
      "trustedSource": "dispatch-commit",
      "authority": ["complete-regression"],
      "concurrency": "full-regression-",
      "environments": [],
      "artifactRetentionDays": [30]
    },
    {
      "name": "Merged branch cleanup",
      "path": ".github/workflows/merged-branch-cleanup.yml",
      "state": "active",
      "triggers": ["pull_request_target:closed"],
      "permissions": ["contents: write"],
      "trustedSource": "default-branch",
      "authority": ["matching-merged-head-delete"],
      "concurrency": "merged-branch-cleanup-",
      "environments": [],
      "artifactRetentionDays": []
    },
    {
      "name": "Release",
      "path": ".github/workflows/release.yml",
      "state": "active",
      "triggers": ["schedule", "workflow_dispatch"],
      "permissions": ["contents: read", "contents: write", "id-token: write"],
      "trustedSource": "authoritative-develop",
      "authority": ["npm-next", "npm-latest", "release-tag", "github-release", "master-fast-forward"],
      "concurrency": "a1-registry-publication",
      "environments": ["npm-publish"],
      "artifactRetentionDays": [1, 30]
    }
  ]
}
